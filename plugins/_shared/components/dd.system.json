        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 28
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "medium": {
          "$ref": "#/$defs/medium"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "about": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "status": {
