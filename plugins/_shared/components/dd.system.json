        "control": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "story": {
          "$ref": "#/$defs/id"
        },
        "block": {
          "$ref": "#/$defs/id"
        }
      }
    }
  },
  "$defs": {
