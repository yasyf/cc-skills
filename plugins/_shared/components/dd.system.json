            "handoff",
            "watcher",
            "keys",
            "budget",
            "timer",
            "uploader",
            "codec",
            "compactor",
            "sweeper",
            "cache",
            "ui",
            "tool",
            "docs",
            "sdk",
            "module",
            "store"
