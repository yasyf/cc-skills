{
  "$comment": "generated by sync-system-map.sh from yasyf/cc-present@v0.53.0; edit the source there",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "display.system",
  "description": "A hand-drawn map of a running system (system-map/v1): typed blocks listed in the order a request meets them, links at any grain, the main path, stories and sticky notes. The renderer owns every position.",
  "type": "object",
  "required": [
