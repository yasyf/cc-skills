{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          { "type": "command", "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" && exec \"$python\" -I \"${CLAUDE_PLUGIN_ROOT}/hooks/installed.py\" session_start.py" }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" && exec \"$python\" -I \"${CLAUDE_PLUGIN_ROOT}/hooks/installed.py\" compacted_skill.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "[ -z \"$LONG_RUNNING_HANDLER\" ] || . \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\"; [ -z \"$LONG_RUNNING_HANDLER\" ] || exec \"$python\" -I \"${CLAUDE_PLUGIN_ROOT}/hooks/installed.py\" one_line_result.py" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" && exec \"$python\" -I \"${CLAUDE_PLUGIN_ROOT}/hooks/installed.py\" pre_compact.py" }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" && exec \"$python\" -I \"${CLAUDE_PLUGIN_ROOT}/hooks/installed.py\" bash_guard.py" }
        ]
      }
    ]
  }
}
