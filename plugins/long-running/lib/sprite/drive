#!/usr/bin/env python3
"""drive on a Sprite lane: each verb runs on the coordinator's Mac, where the drive's records live.

It asks the verb as one blocking Orca question, `DRIVE <its words>` over the JSON of what goes with it: stdin when a word
is `-`, and the text of each file a word names. The drive's watch runs it there for this lane's job and answers
`drive exited <status>` over what it printed, which this prints, exiting with that status. A long answer comes as a line naming
the file the coordinator wrote it to on this Sprite, which this reads in its place once its size and SHA-256 match. While no
answer comes it says so on stderr every 30 s, naming the question, and at 240 s, inside the 5 minutes a prompt cache lives and the 600000 ms a Bash call
waits at most, it gives up on it, exiting 1; the Mac answers any verb still running at 225 s as still running.
`--root`, `manual` and `--help`, whose answers no drive state moves, are answered from this Sprite's copy of the last answer for an
hour after the Mac first gives one, with no round trip.
"""

import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path

ANSWER = re.compile(r"drive exited (\d+)\n?")
KEPT = re.compile(r"drive answer kept on this Sprite: (\S+) \((\d+) bytes, SHA-256 ([0-9a-f]{64})\); read it in full\n?")
QUESTION_BYTES = 120_000
WAIT_MS = 30_000
STOP_MS = 240_000
STATIC = (("--root",), ("manual",), ("--help",), ("-h",))
STATIC_SECONDS = 3600


def main(argv: list[str]) -> int:
    if (kept := static_kept(argv)) is not None:
        print(kept, end="")
        return 0
    sent: dict = {"files": {word: {"text": Path(word).read_text(), "executable": os.access(word, os.X_OK)} for word in dict.fromkeys(argv) if os.path.isfile(word)}}
    if "-" in argv:
        sent["stdin"] = sys.stdin.read()
    question = f"DRIVE {shlex.join(argv)}\n{json.dumps(sent)}"
    if len(question.encode()) > QUESTION_BYTES:
        print(
            f"drive: refused, nothing sent: its words, stdin and files come to {len(question.encode())} bytes, past the {QUESTION_BYTES}"
            " an Orca question carries here, since Linux takes at most 128 KiB in one argument: cut what goes with it",
            file=sys.stderr,
        )
        return 2
    asked = ask("--question", question)
    for waited in range(WAIT_MS, STOP_MS, WAIT_MS):
        if not asked.get("timedOut"):
            break
        print(f"drive: no answer yet from the coordinator's Mac to `drive {shlex.join(argv)}`, Orca question {asked['messageId']}, {waited // 1000} s in; still waiting", file=sys.stderr)
        asked = ask("--resume", asked["messageId"])
    if asked.get("timedOut"):
        raise SystemExit(
            f"drive: no answer in {STOP_MS // 1000} s from the coordinator's Mac to `drive {shlex.join(argv)}`, Orca question {asked['messageId']}:"
            " its watch may still run it, so read what it would change before asking again"
        )
    answer = asked.get("answer") or ""
    status = ANSWER.match(answer)
    if kept := KEPT.fullmatch(answer[status.end() :] if status else answer):
        answer = kept_answer(*kept.groups())
        status = ANSWER.match(answer)
    if printed := answer[status.end() :] if status else answer:
        print(printed)
    if status and status[1] == "0" and static(argv):
        keep_static(argv, f"{printed}\n" if printed else "")
    return int(status[1]) if status else 1


def static(argv: list[str]) -> bool:
    return any(tuple(argv[: len(verb)]) == verb or verb[0] in ("--help", "-h") and verb[0] in argv for verb in STATIC)


def static_path(argv: list[str]) -> Path:
    folder = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "long-running-drive"
    return folder / f"{hashlib.sha256(json.dumps([hashlib.sha256(Path(__file__).read_bytes()).hexdigest(), argv]).encode()).hexdigest()}.txt"


def static_kept(argv: list[str]) -> str | None:
    path = static_path(argv)
    if not static(argv) or not path.is_file() or time.time() - path.stat().st_mtime > STATIC_SECONDS:
        return None
    return path.read_text()


def keep_static(argv: list[str], printed: str) -> None:
    path = static_path(argv)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(printed)


def kept_answer(path: str, size: str, digest: str) -> str:
    text = Path(path).read_bytes()
    if len(text) != int(size) or hashlib.sha256(text).hexdigest() != digest:
        raise SystemExit(f"drive: the answer at {path} is {len(text)} bytes with SHA-256 {hashlib.sha256(text).hexdigest()}, not the {size} bytes with SHA-256 {digest} the coordinator kept")
    return text.decode()


def ask(*words: str) -> dict:
    done = subprocess.run(["orca", "orchestration", "ask", *words, "--wait", "--timeout-ms", str(WAIT_MS), "--json"], capture_output=True, text=True, check=False)
    asked = json.loads(done.stdout)["result"] if done.stdout.strip() else {}
    if done.returncode and not asked.get("timedOut"):
        raise SystemExit(f"drive: orca orchestration ask exited {done.returncode}: {(done.stderr or done.stdout).strip()}")
    return asked


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
