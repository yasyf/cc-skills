 "merge_queue.py:ROUTED_BLOCKER": {
  "flags": 32,
  "pattern": "^(?:graphite (?:FAILING\\w*|MERGE_CONFLICTS|EVICTED)|unproven: |fidelity (?:failure|error):|conflicts with origin/|GitHub reads CONFLICTING|carries .* already squashed on|changes requested by |ejected from the merge queue)"
 },
 "merge_queue.py:SAID_WOULD": {
  "flags": 40,
  "pattern": "^would enqueue\\b.*$"
 },
 "merge_queue.py:STATUS_LINE": {
  "flags": 40,
  "pattern": "^#(?P<pr>\\d+) (?P<status>[A-Z_]+) "
 },
 "merge_queue.py:TRANSIENT_FAILURE": {
  "flags": 32,
  "pattern": "left no result, a transient failure|TLS handshake timeout|i/o timeout|context deadline exceeded|urlopen error|Connection reset|Connection refused|reset by peer|Remote end closed|Temporary failure in name resolution|nodename nor servname|Name or service not known|HTTP(?: Error)? 5\\d\\d|[Oo]peration timed out|Failed to connect to .* port 443|Recv failure|Could not resolve host"
 },
 "merge_queue.py:TRUNK_LIMITED": {
  "flags": 32,
  "pattern": "HTTP 429\\b"
 },
 "merge_queue.py:TRUNK_REQUIRED_CHECK": {
  "flags": 32,
  "pattern": "^required check .+ is (\\S+)$"
 },
 "merge_queue.py:TRUNK_WOULD_ENQUEUE": {
  "flags": 40,
  "pattern": "^would enqueue native stack through #\\d+: ((?:#\\d+ ?)+)$"
 },
 "merge_queue.py:VERDICT_LINE": {
  "flags": 40,
  "pattern": "^#(?P<pr>\\d+) (?P<verdict>[A-Z]+) (?P<sha>[0-9a-f]{0,10}) ?(?P<detail>.*)$"
 },
 "merge_queue.py:WOULD_ENQUEUE": {
  "flags": 40,
  "pattern": "^would enqueue ((?:#\\d+ ?)+) in one call$"
 }
}
