#!/usr/bin/env bash
set -euo pipefail
plugin=$(cd "$(dirname "$0")/.." && pwd)
repo=$(git -C "$plugin" rev-parse --show-toplevel)
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
export LONG_RUNNING_STATE="$scratch/state" CLAUDE_CONFIG_DIR="$scratch/config"
mkdir -p "$LONG_RUNNING_STATE" "$CLAUDE_CONFIG_DIR"
python=(uv run --no-project --quiet --python 3.13 --with pytest --with pytest-timeout --with pytest-xdist --with "spawnllm>=0.17.7" python -I)

"$plugin/tools/typecheck"

"${python[@]}" - "$plugin" <<'EOF'
import re
import sys
from pathlib import Path

plugin = Path(sys.argv[1])
sys.path.insert(0, str(plugin / "lib"))
from drive import cli

called = re.compile(r'page_parts\(\(PAGES / "([^"]+)"\)\.read_text\(\), "([^"]+)"\)')
reads = {found for source in [*(plugin / "lib" / "drive").glob("*.py"), *(plugin / "hooks").glob("*.py")] for found in called.findall(source.read_text())}
if not reads:
    raise SystemExit("smoke: no page_parts read of a shipped page found; the pattern this check reads has drifted from the code")
missing = [f"{page} has no part {words!r}" for page, words in sorted(reads) if not cli.page_parts((cli.PAGES / page).read_text(), words)]
if missing:
    raise SystemExit("smoke: code reads a part its shipped page lacks:\n" + "\n".join(missing))
print(f"smoke: each of {len(reads)} page parts the code reads is in its shipped page")
EOF

"${python[@]}" - "$plugin" <<'EOF'
import argparse
import contextlib
import importlib
import io
import pkgutil
import sys
from pathlib import Path

plugin = Path(sys.argv[1])
sys.path.insert(0, str(plugin / "lib"))
import drive

modules = sorted(found.name for found in pkgutil.iter_modules(drive.__path__))
for module in modules:
    importlib.import_module(f"drive.{module}")
print(f"smoke: imported {len(modules)} drive modules")

from drive import cli


def leaves(parser: argparse.ArgumentParser, words: list[str]):
    groups = [action for action in parser._actions if isinstance(action, argparse._SubParsersAction)]
    if not groups and parser.add_help:
        yield words
    for group in groups:
        for name, child in group.choices.items():
            yield from leaves(child, [*words, name])


failed = []
verbs = list(leaves(cli.parser(), []))
for words in verbs:
    out = io.StringIO()
    try:
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(out):
            cli.main([*words, "--help"])
    except SystemExit as done:
        if done.code in (0, None):
            continue
        failed.append(f"drive {' '.join(words)} --help exited {done.code}: {out.getvalue().strip()[-400:]}")
    except Exception as error:
        failed.append(f"drive {' '.join(words)} --help raised {type(error).__name__}: {error}")
    else:
        failed.append(f"drive {' '.join(words)} --help printed help without exiting")
if failed:
    raise SystemExit("smoke: " + "\nsmoke: ".join(failed))
print(f"smoke: drive --help ran for {len(verbs)} verbs")
EOF

"${python[@]}" "$plugin/bin/drive" --help > /dev/null
echo "smoke: bin/drive --help runs"

"${python[@]}" "$plugin/tools/demo-drive" "$LONG_RUNNING_STATE"
"$plugin/tools/try-watch" demo

"${python[@]}" - "$plugin" "$scratch" <<'EOF'
import json
import os
import subprocess
import sys
from pathlib import Path

plugin, scratch = Path(sys.argv[1]), Path(sys.argv[2])
(scratch / "transcript.jsonl").write_text("")
events = json.loads((plugin / "hooks" / "hooks.json").read_text())["hooks"]
failed, ran = [], 0
for event, groups in events.items():
    for group in groups:
        for command in group["hooks"]:
            hook = command["command"].rsplit(" ", 1)[-1]
            payload = {
                "session_id": "smoke",
                "transcript_path": str(scratch / "transcript.jsonl"),
                "cwd": str(scratch),
                "hook_event_name": event,
                "source": "startup",
                "trigger": "auto",
                "tool_name": "Bash",
                "tool_input": {"command": "echo smoke"},
                "permission_mode": "default",
            }
            job = {"LONG_RUNNING_JOB": "demo/j1/builder/smoke", "CLAUDE_LONG_RUNNING_DRIVE": "demo"} if "LONG_RUNNING_JOB" in command["command"] else {}
            done = subprocess.run(["python3", "-I", str(plugin / "hooks" / "installed.py"), hook], input=json.dumps(payload), capture_output=True, text=True, timeout=120, env=os.environ | job)
            ran += 1
            if done.returncode not in (0, 2) or "Traceback" in done.stderr:
                failed.append(f"{event} {hook} exited {done.returncode}: {done.stderr.strip()[-600:]}")
if failed:
    raise SystemExit("smoke: " + "\nsmoke: ".join(failed))
print(f"smoke: {ran} hooks ran on a canned payload")
EOF

cd "$repo"
tests=plugins/long-running/tests
"${python[@]}" -m pytest -q -n 4 --timeout=30 -p no:cacheprovider \
  "$tests/test_state.py::test_write_baseline_reuses_unchanged_fields_and_decodes_changes_without_cyclic_scans" \
  "$tests/test_state.py::test_row_snapshot_baseline_decodes_only_changed_and_removed_rows" \
  "$tests/test_state.py::test_selected_loads_decode_only_requested_fields_and_keep_independent_copies" \
  "$tests/test_state.py::test_writes_reuse_the_loaded_snapshot_without_encoding_the_whole_drive" \
  "$tests/test_state.py::test_selected_loads_observe_other_processes_saves_and_batch_writes" \
  "$tests/test_state.py::test_row_snapshot_baseline_preserves_json_serializable_typed_values" \
  "$tests/test_watch.py::test_a_job_drive_job_add_recorded_is_not_started_until_its_worker_records_itself_and_an_orphan_a_minute_on_by_the_clock_however_long_the_pass_though_its_part_was_said_since_its_last_tick" \
  "$tests/test_watch.py::test_a_watch_process_a_newer_install_ends_at_its_first_read_still_says_a_never_started_jobs_orphan_and_heals_no_gap_its_lanes_were_not_read_for" \
  "$tests/test_state.py::test_normalized_load_and_tracked_write_leave_unaccessed_records_encoded" \
  "$tests/test_quoted_commands.py" \
  "$tests/test_modules.py" \
  "$tests/test_reactions.py" \
  "$tests/test_github.py::test_contains_holds_a_pr_by_net_content_a_hotfix_copy_on_other_context_counting_and_a_copy_later_reverted_not" \
  "$tests/test_state.py::test_owner_page_presence_uses_its_index" \
  "$tests/test_watch.py::test_idle_owner_page_stage_does_not_load_the_drive" \
  "$tests/test_watch.py::test_a_page_for_real_users_failing_while_he_is_away_starts_its_fix_and_diagnosis_and_goes_out_though_slack_refuses_its_line_which_the_watch_posts_in_the_drive_channel_next_pass_once" \
  "$tests/test_installed_hooks.py" \
  "$tests/test_state.py::test_outbox_replay_reads_only_pending_messages_through_its_index" \
  "$tests/test_state.py::test_close_report_presence_uses_its_index_and_tracks_row_changes" \
  "$tests/test_watch.py::test_empty_close_report_stage_does_not_load_the_drive" \
  "$tests/test_watch.py::test_a_close_report_drive_install_kept_posts_from_the_watch_once_cci_takes_it_and_survives_a_refusal_to_the_next_watch" \
  "$tests/test_state.py::test_a_save_keeps_the_newest_release_that_saved_the_drive_which_each_older_install_reads_as_newer" \
  "$tests/test_state.py::test_row_cache_updates_and_deletions_do_not_sort_unchanged_positions" \
  "$tests/test_state.py::test_row_cache_reorders_inserted_or_moved_rows" \
  "$tests/test_cli.py::test_start_creates_the_drive_and_prints_the_roles_context" \
  "$tests/test_cli.py::test_order_show_and_job_show_print_what_status_prints" \
  "$tests/test_cli.py::test_status_prints_each_order_its_ids_name_whole_and_closed_ones_too" \
  "$tests/test_cli.py::test_drive_manual_with_no_page_lists_the_pages" \
  "$tests/test_watch.py::test_merge_is_reported_and_the_pr_leaves_the_read_set" \
  "$tests/test_watch.py::test_drive_status_shows_each_open_prs_stage_now_keeping_its_since_only_while_the_watch_kept_that_stage"
echo "smoke: passed"
