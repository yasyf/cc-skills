#!/usr/bin/env python3
"""Refuse each line a change adds to long-running's code, hooks, agents or skill text that names one repository's specifics, by the patterns in foreign-names.patterns: those belong in that repository's .claude/long-running.toml.

Usage: foreign-names <base>   compares HEAD with <base>, the merge base of a pull request or the push's previous head.
"""

import re
import subprocess
import sys
from pathlib import Path

PATTERNS = [re.compile(line) for line in (Path(__file__).with_name("foreign-names.patterns")).read_text().splitlines() if line]
SCANNED = ("plugins/long-running/lib/", "plugins/long-running/hooks/", "plugins/long-running/agents/", "plugins/long-running/skills/", "plugins/long-running/capt-hook/hooks/", "plugins/long-running/lane-rules/")
SPARED = ("plugins/long-running/lib/drive/site/vendor/", "plugins/long-running/capt-hook/hooks/tests/")


def scanned(path: str) -> bool:
    return path.startswith(SCANNED) and not path.startswith(SPARED) and "/tests/" not in path


def found(line: str) -> list[str]:
    return [match[0] for pattern in PATTERNS if (match := pattern.search(line))]


def main(base: str) -> int:
    diff = subprocess.run(["git", "diff", "--unified=0", "--no-color", f"{base}...HEAD", "--", *SCANNED], capture_output=True, text=True, check=True).stdout
    path, refused = "", []
    for line in diff.splitlines():
        if line.startswith("+++ "):
            path = line.removeprefix("+++ b/")
        elif line.startswith("+") and scanned(path) and (names := found(line[1:])):
            refused.append(f"{path}: adds {', '.join(names)}: {line[1:].strip()[:160]}")
    for refusal in refused:
        print(refusal)
    if refused:
        print("long-running names no one repository's specifics; put them in that repository's .claude/long-running.toml and read them from there.")
    return 1 if refused else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1]))
