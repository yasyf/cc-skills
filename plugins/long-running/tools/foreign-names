#!/usr/bin/env python3
"""Refuse each line a change adds to long-running's code, hooks, agents or skill text that names one repository's specifics, by the patterns in foreign-names.patterns: those belong in that repository's .claude/long-running.toml.

Usage: foreign-names <base>   compares HEAD with <base>, the merge base of a pull request or the push's previous head.
       foreign-names --tree   reads every line of every tracked file of the plugin but its tests and vendored code, so none names one repository's specifics; the owner's own Slack channel ids are spared there, since they name no repository, and his-words.json, his messages quoted as he typed them.
"""

import re
import subprocess
import sys
from pathlib import Path

PATTERNS = [re.compile(line) for line in (Path(__file__).with_name("foreign-names.patterns")).read_text().splitlines() if line]
SLACK_ID = r"\bC0[A-Z0-9]{8,}\b"
PLUGIN = "plugins/long-running/"
SCANNED = ("plugins/long-running/lib/", "plugins/long-running/hooks/", "plugins/long-running/agents/", "plugins/long-running/skills/", "plugins/long-running/capt-hook/hooks/", "plugins/long-running/lane-rules/")
SPARED = ("plugins/long-running/lib/drive/site/vendor/", "plugins/long-running/his-words.json", "plugins/long-running/capt-hook/hooks/tests/", "plugins/long-running/tools/foreign-names", "plugins/long-running/uv.lock")


def scanned(path: str) -> bool:
    return path.startswith(SCANNED) and not path.startswith(SPARED) and "/tests/" not in path


def found(line: str, patterns: list[re.Pattern] = PATTERNS) -> list[str]:
    return [match[0] for pattern in patterns if (match := pattern.search(line))]


def tree() -> list[str]:
    paths = subprocess.run(["git", "ls-files", "--", PLUGIN], capture_output=True, text=True, check=True).stdout.splitlines()
    patterns = [pattern for pattern in PATTERNS if pattern.pattern != SLACK_ID]
    refused = []
    for path in paths:
        if path.startswith(SPARED) or "/tests/" in path:
            continue
        try:
            lines = Path(path).read_text().splitlines()
        except UnicodeDecodeError:
            continue
        refused += [f"{path}:{number}: names {', '.join(names)}: {line.strip()[:160]}" for number, line in enumerate(lines, 1) if (names := found(line, patterns))]
    return refused


def main(base: str) -> int:
    if base == "--tree":
        return report(tree())
    diff = subprocess.run(["git", "diff", "--unified=0", "--no-color", f"{base}...HEAD", "--", *SCANNED], capture_output=True, text=True, check=True).stdout
    path, refused = "", []
    for line in diff.splitlines():
        if line.startswith("+++ "):
            path = line.removeprefix("+++ b/")
        elif line.startswith("+") and scanned(path) and (names := found(line[1:])):
            refused.append(f"{path}: adds {', '.join(names)}: {line[1:].strip()[:160]}")
    return report(refused)


def report(refused: list[str]) -> int:
    for refusal in refused:
        print(refusal)
    if refused:
        print("long-running names no one repository's specifics; put them in that repository's providers, which its .claude/long-running.toml names under [providers], and read them from there.")
    return 1 if refused else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1]))
