#!/usr/bin/env bash
set -euo pipefail
plugin=$(cd "$(dirname "$0")/.." && pwd)
repo=$(git -C "$plugin" rev-parse --show-toplevel)
folder=$(git -C "$plugin" rev-parse --show-prefix)
pinned=$(git -C "$repo" for-each-ref --count=1 --sort=-v:refname --format='%(refname:short)' 'refs/tags/long-running--v*')
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
git -C "$repo" archive "$pinned" "$folder" | tar -x -C "$scratch"
if [ ! -e "$scratch/${folder}tools/demo-drive" ]; then
  echo "try-release: $pinned ships no tools/demo-drive, so there is no drive of it to try"
  exit 0
fi
# drive status names his DM from `cc-slack whoami`; a runner has no cc-slack, so this one answers it as the tests' his_dm fixture does.
mkdir -p "$scratch/config/plugins" "$scratch/cc-slack/bin"
cat > "$scratch/cc-slack/bin/cc-slack" <<'EOF'
#!/bin/sh
[ "$1" = whoami ] && exec echo '{"dm_channel_id": "D123", "team_url": "https://demo.slack.com"}'
exit 1
EOF
chmod +x "$scratch/cc-slack/bin/cc-slack"
printf '{"version": 2, "plugins": {"cc-slack@cc-slack": [{"installPath": "%s"}]}}' "$scratch/cc-slack" > "$scratch/config/plugins/installed_plugins.json"
python=(uv run --no-project python -I)
"${python[@]}" "$scratch/${folder}tools/demo-drive" "$scratch/state"
CLAUDE_CONFIG_DIR="$scratch/config" LONG_RUNNING_STATE="$scratch/state" "${python[@]}" "$plugin/bin/drive" status --drive demo > "$scratch/status.txt" 2>&1 \
  || { tail -20 "$scratch/status.txt"; echo "try-release: this tree's drive status cannot read the demo drive $pinned saved"; exit 1; }
echo "try-release: this tree's drive status reads the demo drive $pinned saved"
