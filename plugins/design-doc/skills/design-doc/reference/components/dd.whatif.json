{
  "kind": "dd.whatif",
  "title": "What if",
  "summary": "Named inputs on sliders, outputs derived from them by an arithmetic expression. The expression grammar is + - * / ( ) min max over numbers and input ids; there is no eval, so an expression that does not parse fails check.",
  "belongs": "Numbers, where a rate multiplies out, and Where it breaks, where a ceiling has a guard the reader wants to move.",
  "type": "object",
  "required": ["kind", "inputs", "outputs"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "dd.whatif"},
    "title": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "min", "max", "value"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "min": {"type": "number"},
          "max": {"type": "number"},
          "step": {"type": "number", "exclusiveMinimum": 0},
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1}
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["label", "expr"],
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "expr": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "decimals": {"type": "integer", "minimum": 0, "maximum": 4},
          "tone": {"enum": ["ok", "warn", "bad"]}
        }
      }
    },
    "cites": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "example": {
    "kind": "dd.whatif",
    "title": "Exposure window after a worker is removed",
    "inputs": [
      {"id": "ttl", "label": "Lease lifetime", "min": 1, "max": 24, "step": 1, "value": 24, "unit": "h"},
      {"id": "renew", "label": "Renewals allowed", "min": 0, "max": 4, "step": 1, "value": 1}
    ],
    "outputs": [
      {"label": "Worst-case work after removal", "expr": "ttl * (1 + renew)", "unit": "h", "tone": "warn"},
      {"label": "Shortest window", "expr": "min(ttl, 4)", "unit": "h", "decimals": 0}
    ],
    "cites": ["DQ2"]
  }
}
