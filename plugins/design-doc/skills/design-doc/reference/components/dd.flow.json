{
  "kind": "dd.flow",
  "title": "Flow with callouts",
  "summary": "Columns along a path, left to right, each carrying the callouts that sit on it: what leaks, breaks or changes there, solid when this design closes it and dashed when it stays open. The renderer measures every label and spaces the columns to their callouts, so nothing overlaps.",
  "belongs": "A compare panel whose figure lays findings along a request path; a callout's topic names the .xs-topic row it explains, and the two highlight each other.",
  "type": "object",
  "required": ["kind", "columns", "callouts"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "dd.flow"},
    "title": {"type": "string", "minLength": 1},
    "columns": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "sub": {"type": "string", "minLength": 1}
        }
      }
    },
    "callouts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["col", "title", "status"],
        "additionalProperties": false,
        "properties": {
          "col": {"type": "string", "minLength": 1, "description": "the id of the column this callout sits on"},
          "title": {"type": "string", "minLength": 1},
          "sub": {"type": "string", "minLength": 1},
          "status": {"enum": ["closed", "open"]},
          "side": {"enum": ["above", "below"], "description": "which side of the column; unset callouts go above, the fourth and later below"},
          "topic": {"type": "string", "minLength": 1, "description": "the .xs-topic text of the compare row this callout explains"}
        }
      }
    },
    "legend": {
      "type": "object",
      "required": ["closed", "open"],
      "additionalProperties": false,
      "properties": {
        "closed": {"type": "string", "minLength": 1},
        "open": {"type": "string", "minLength": 1}
      }
    },
    "arrows": {"type": "boolean", "description": "arrows between consecutive columns; on unless set to false"}
  },
  "example": {
    "kind": "dd.flow",
    "columns": [
      {"id": "client", "label": "Client"},
      {"id": "plat", "label": "Plat edge"},
      {"id": "tenant", "label": "Tenant cluster"},
      {"id": "db", "label": "Postgres"}
    ],
    "callouts": [
      {"col": "plat", "title": "Break-glass and SandSQL", "sub": "closes: both rules deleted", "status": "closed", "topic": "Plat detours"},
      {"col": "plat", "title": "GraphQL lands on plat", "sub": "closes: hostname routing", "status": "closed", "topic": "Dashboard"},
      {"col": "plat", "title": "Journals on plat's Restate", "sub": "stays open: follow-up design", "status": "open", "side": "below", "topic": "Durable execution"},
      {"col": "tenant", "title": "Dispatch TLS commented out", "sub": "closes: tenant-host dispatch", "status": "closed", "topic": "Plat detours"},
      {"col": "tenant", "title": "Hop on port 80, unproven", "sub": "closes: tenant NLB as origin", "status": "closed", "topic": "Who decrypts"},
      {"col": "tenant", "title": "Cache shared by plat's teams", "sub": "closes: per-team home", "status": "closed", "side": "below", "topic": "Prompt cache"},
      {"col": "db", "title": "One role, every row", "sub": "closes: row policies", "status": "closed", "topic": "Database rows"}
    ],
    "legend": {"closed": "closed by this design", "open": "stays open, a follow-up design"}
  }
}
