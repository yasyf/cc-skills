{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "350000",
    "CLAUDE_CODE_DISABLE_FILE_CHECKPOINTING": "1",
    "CHOKIDAR_USEPOLLING": "1",
    "CHOKIDAR_INTERVAL": "300000",
    "CLAUDE_CODE_DISABLE_MOUSE": "1",
    "CLAUDE_CODE_SYNTAX_HIGHLIGHT": "false",
    "CLAUDE_CODE_DISABLE_AGENT_PROGRESS_SUMMARIES": "1",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "false",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_COST_WARNINGS": "1",
    "DISABLE_INSTALLATION_CHECKS": "1",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_GB_DISK_CACHE_WHEN_TELEMETRY_OFF": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1",
    "CLAUDE_CODE_PLUGIN_DIR_WATCH": "false",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1"
  },
  "spriteEnv": {
    "CARGO_BUILD_JOBS": "2",
    "CARGO_INCREMENTAL": "0",
    "GOCACHE": "/var/tmp/build/go",
    "CARGO_TARGET_DIR": "/var/tmp/build/cargo",
    "MCP_TIMEOUT": "120000"
  },
  "settings": {
    "spinnerTipsEnabled": false,
    "prefersReducedMotion": true,
    "verbose": false,
    "showThinkingSummaries": false,
    "feedbackDrafts": "off",
    "awaySummaryEnabled": false,
    "promptSuggestionEnabled": false,
    "tui": "fullscreen",
    "disableDeepLinkRegistration": "disable",
    "statusLine": {
      "type": "command",
      "command": "exit 0"
    },
    "terminalProgressBarEnabled": false,
    "bashOutputMaxChars": 6000,
    "outputStyle": "default"
  },
  "spriteSettings": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "curl -fsS -m 5 --unix-socket /.sprite/api.sock -H 'Host: sprite' -H 'Content-Type: application/json' -X PUT http://sprite/v1/tasks/claude-lane -d '{\"expire\":\"1h\"}' >/dev/null"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "curl -fsS -m 5 --unix-socket /.sprite/api.sock -H 'Host: sprite' -H 'Content-Type: application/json' -X PUT http://sprite/v1/tasks/claude-lane -d '{\"expire\":\"1h\"}' >/dev/null"
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "curl -fsS -m 5 --unix-socket /.sprite/api.sock -H 'Host: sprite' -H 'Content-Type: application/json' -X PUT http://sprite/v1/tasks/claude-lane -d '{\"expire\":\"1h\"}' >/dev/null"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "curl -fsS -m 5 --unix-socket /.sprite/api.sock -H 'Host: sprite' -H 'Content-Type: application/json' -X PUT http://sprite/v1/tasks/claude-lane -d '{\"expire\":\"30m\"}' >/dev/null"
            }
          ]
        }
      ]
    }
  },
  "deniedTools": [
    "AskUserQuestion",
    "EnterPlanMode",
    "ExitPlanMode",
    "PushNotification",
    "DesignSync"
  ],
  "spriteDeniedTools": [
    "mcp__plugin_cc-slack_cc-slack__slack_send",
    "mcp__plugin_cc-slack_cc-slack__slack_reply",
    "mcp__plugin_cc-slack_cc-slack__slack_edit",
    "mcp__plugin_cc-slack_cc-slack__slack_delete",
    "mcp__plugin_cc-slack_cc-slack__slack_react",
    "mcp__plugin_cc-slack_cc-slack__slack_unreact",
    "mcp__plugin_cc-slack_cc-slack__slack_stream",
    "mcp__plugin_cc-slack_cc-slack__slack_pickup",
    "mcp__plugin_cc-slack_cc-slack__slack_dm_status",
    "mcp__plugin_cc-slack_cc-slack__slack_card_answer",
    "mcp__plugin_cc-slack_cc-slack__slack_revoke",
    "mcp__plugin_cc-slack_cc-slack__slack_withdraw_pr_card",
    "mcp__plugin_cc-slack_cc-slack__slack_channel_archive",
    "mcp__plugin_cc-slack_cc-slack__slack_channel_create",
    "mcp__plugin_cc-slack_cc-slack__slack_channel_invite",
    "mcp__plugin_cc-slack_cc-slack__slack_channel_join",
    "mcp__plugin_cc-slack_cc-slack__slack_channel_topic",
    "Bash(cc-slack send:*)",
    "Bash(cc-slack reply:*)",
    "Bash(cc-slack edit:*)",
    "Bash(cc-slack delete:*)",
    "Bash(cc-slack react:*)",
    "Bash(cc-slack unreact:*)",
    "Bash(cc-slack pin:*)",
    "Bash(cc-slack stream:*)",
    "Bash(cc-slack pickup:*)",
    "Bash(cc-slack dm-status:*)",
    "Bash(cc-slack dm-relay:*)",
    "Bash(cc-slack apply:*)",
    "Bash(cc-slack canvas:*)",
    "Bash(cc-slack card-answer:*)",
    "Bash(cc-slack card-reopen:*)",
    "Bash(cc-slack move-card:*)",
    "Bash(cc-slack withdraw-pr-card:*)",
    "Bash(cc-slack channel-archive:*)",
    "Bash(cc-slack channel-create:*)",
    "Bash(cc-slack channel-invite:*)",
    "Bash(cc-slack channel-join:*)",
    "Bash(cc-slack channel-topic:*)",
    "mcp__plugin_datadog_mcp__execute_code_write",
    "mcp__plugin_datadog_mcp__upsert_datadog_dashboard",
    "mcp__plugin_datadog_mcp__create_datadog_notebook",
    "mcp__plugin_datadog_mcp__edit_datadog_notebook",
    "mcp__plugin_datadog_mcp__delete_datadog_notebook",
    "mcp__plugin_datadog_mcp__recover_datadog_notebook"
  ]
}
